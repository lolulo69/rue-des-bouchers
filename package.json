{
  "name": "rue-des-bouchers",
  "version": "1.0.0",
  "description": "Jeu 3D (three.js) : Pilou contre les terrasses de la rue des Bouchers, Lille",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sim": "node scripts/sim.js",
    "test:perf": "playwright test -c playwright.perf.config.js",
    "check:bundle": "vite build && node scripts/check-bundle.js",
    "qa:screens": "QA_SCREENS=1 playwright test screens",
    "story": "node scripts/story.js",
    "test:fullrun": "QA_FULLRUN=1 playwright test fullrun --workers=1"
  },
  "keywords": [],
  "author": "Lucas Lefort",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true
}
